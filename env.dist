BOT_TOKEN=''
# YooCassa
# .env
YOOKASSA_SHOP_ID=''
YOOKASSA_SECRET_KEY=''
# Сохранение карты и автоплатежи (рекурренты). Включать True только ПОСЛЕ одобрения
# рекуррентов магазином в ЮKassa, иначе создание платежа будет падать. По умолчанию False.
YOOKASSA_SAVE_PAYMENT_METHOD='False'
# DB
DB_NAME=''
DB_USER=''
DB_PASSWORD=''
DB_HOST=postgres
DB_PORT=5432
# Not used in opensource version
BOT_IP=127.0.0.1
SERVER_URL=''
DOMAIN=''
USE_WEBHOOK=False
# Telegram ID администратора (несколько — через запятую)
ADMIN=
# Absolute paths required for Docker volume mounts
CERT_FULLCHAIN_PATH=/absolute/path/to/fullchain.pem
CERT_KEY_PATH=/absolute/path/to/privkey.pem

# Remnawave (внешняя панель управления VPN-пользователями)
REMNAWAVE_API_URL=
REMNAWAVE_API_TOKEN=
REMNAWAVE_DEFAULT_SQUAD_UUID=
# Только для eGames reverse proxy: часть секретной ссылки после "?", формат name=value
REMNAWAVE_ACCESS_COOKIE=
# Резервный HTTP/SOCKS5-прокси для API-запросов к панели. Пустой = только прямой
# маршрут. Если задан — бот сначала ходит напрямую, и лишь когда прямой путь до
# панели не отвечает (ConnectTimeout и т.п.), повторяет запрос через этот прокси.
# httpx резолвит DNS на стороне прокси, поэтому подойдёт socks5:// (не нужен socks5h).
# Формат: socks5://user:pass@HOST:PORT  или  http://user:pass@HOST:PORT
REMNAWAVE_PROXY_URL=
# Только hostname публичной страницы подписки, без https:// и завершающего /
REMNAWAVE_SUB_HOST=sub.flaskvpn.ru

# Web App
SECRET_KEY=your-secret-key-here

# Telegram Mini App (docs/tma-roadmap.md). Обе переменные опциональны:
# без TG_BOT_USERNAME экран /tma/referral скрывает блок "поделиться ссылкой".
# Username бота без "@", как в его t.me-ссылке.
TG_BOT_USERNAME=
# Короткое имя Mini App, заданное в BotFather при /newapp (часть ссылки t.me/<bot>/<app>).
TMA_APP_NAME=app
# Режим интерфейса бота для ВСЕХ пользователей:
#   bot — классические кнопки со сценариями внутри бота (значение по умолчанию);
#   tma — те же пункты меню открывают соответствующие экраны Mini App.
# Переключение требует перезапуска flask_bot. В режиме tma нужен настоящий домен:
# на DOMAIN=localhost web_app-кнопки автоматически отключаются (Telegram их
# отвергает вместе со всей клавиатурой), то есть бот работает как при UI_MODE=bot.
UI_MODE=bot

# Mail (SMTP)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@flaskvpn.ru
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# --- Реквизиты для оферты, политики конфиденциальности и подвала сайта ---
# Пока не заполнены, юридические страницы помечаются как черновик.
LEGAL_NAME=
LEGAL_INN=
LEGAL_OGRNIP=
LEGAL_ADDRESS=
LEGAL_EMAIL=
